{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "releaseCommitBody": "full"
  },
  "package": [
    {
      "name": "ferrtrack-mcp",
      "path": "mcp",
      "tagTemplate": "mcp-v{version}",
      "changelog": "mcp/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "mcp/package.json",
          "format": "json"
        },
        {
          "path": "mcp/packages/ferrtrack-mcp/package.json",
          "format": "json"
        }
      ]
    }
  ]
}
